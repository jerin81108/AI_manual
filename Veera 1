#include<stdio.h>

int main() {
    int p[10], f[3], i, j, n, k = 0, fault = 0;

    printf("Enter pages: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &p[i]);

    for(i = 0; i < 3; i++)
        f[i] = -1;

    for(i = 0; i < n; i++) {
        int found = 0;

        for(j = 0; j < 3; j++)
            if(f[j] == p[i])
                found = 1;

        if(!found) {
            f[k] = p[i];
            k = (k + 1) % 3;
            fault++;
        }
    }

    printf("Page Faults = %d", fault);

    return 0;
}
