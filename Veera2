#include<stdio.h>

int main() {
    int p[20], f[10], n, m, i, j, k=0, pf=0;

    printf("Pages: ");
    scanf("%d",&n);

    printf("Enter pages: ");
    for(i=0;i<n;i++)
        scanf("%d",&p[i]);

    printf("Frames: ");
    scanf("%d",&m);

    for(i=0;i<m;i++)
        f[i]=-1;

    for(i=0;i<n;i++) {
        int hit=0;

        for(j=0;j<m;j++)
            if(f[j]==p[i]) hit=1;

        if(!hit) {
            f[k]=p[i];
            k=(k+1)%m;
            pf++;
        }
    }

    printf("Page Faults=%d",pf);
}
